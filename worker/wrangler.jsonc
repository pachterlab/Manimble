// The Examples page's upload service (src/index.ts). Deploy: npm run migrate && npm run deploy.
{
  "name": "manimble-examples",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "api.manimble.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "r2_buckets": [
    // Private: packages are only served through the Worker. Never make it public.
    { "binding": "PACKAGES", "bucket_name": "manimble-examples" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "manimble-examples", "database_id": "3b8053e9-7234-4b66-96a3-7af4dd92b359" }
  ],
  // Uploads per IP address per minute, failed ones included (the daily limit counts only stored ones).
  "ratelimits": [{ "name": "UPLOADS", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "vars": {
    "ALLOWED_ORIGINS": "https://pachterlab.github.io,http://127.0.0.1:8000,http://localhost:8000",
    "GITHUB_REPO": "pachterlab/Manimble"
  }
  // Secrets (npx wrangler secret put NAME): ADMIN_TOKEN (required for reviewing), IP_SALT,
  // and optionally GITHUB_TOKEN (fine-grained, Issues: read and write on GITHUB_REPO) to open review issues.
}
