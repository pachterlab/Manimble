{
  "name": "manimble-examples",
  "license": "BSD-2-Clause",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to .wrangler/state",
    "migrate:local": "wrangler d1 migrations apply manimble-examples --local --persist-to .wrangler/state",
    "migrate": "wrangler d1 migrations apply manimble-examples --remote",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
