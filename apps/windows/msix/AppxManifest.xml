<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (MSIX) of Manimble for Windows. build_release.ps1 -Msix fills in the $...$ tokens:
  the identity comes from Partner Center (Product identity page) through MANIMBLE_STORE_NAME, MANIMBLE_STORE_PUBLISHER
  and MANIMBLE_STORE_PUBLISHER_NAME, and the version from the repository's VERSION file (with a fourth part of 0,
  which the Store requires).

  Manimble is a full-trust desktop app (runFullTrust). File-system and registry write virtualization are off
  (unvirtualizedResources) so it keeps its files in the real %LOCALAPPDATA%\Manimble, as the zip and installer
  builds do: the Python environment the first-launch setup makes there, and the Python (winget) and MiKTeX it may
  install, have to be visible to the terminal and to the user's own tools, not hidden in a per-package copy.
  Partner Center asks why both restricted capabilities are needed; apps/windows/STORE.md has the answers.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop6 rescap">

  <Identity Name="$Name$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Manimble</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <!-- 1903: the first Windows that honours turning write virtualization off -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Manimble" Executable="Manimble.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Manimble"
        Description="Make slides with Manim by editing them on screen"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- .manimble packages open in Manimble (the path arrives as the first argument, as from Explorer before) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="manimble">
            <uap:DisplayName>Manimble Project</uap:DisplayName>
            <uap:Logo>Assets\Document.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/zip">.manimble</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
